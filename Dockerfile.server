FROM python:3.12-slim-trixie

WORKDIR /usr/src/app

COPY requirements.txt requirements.txt
RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
WORKDIR /usr/src/app/ilpostcast
ENV DB_FILE=../ilpostcast.db
# --preload runs create_app() (schema check + podcast list fetch) once, before forking workers.
CMD [ "gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--preload", "app:create_app()" ]
